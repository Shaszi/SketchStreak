# Skopiuj ten plik jako .env (w folderze server/) i uzupełnij wartości.

# Connection string z MongoDB Atlas — login i hasło są jego częścią.
# Bez tej zmiennej aplikacja użyje bazy w pamięci (dane znikną po restarcie).
MONGODB_URI=mongodb+srv://TWOJ_LOGIN:TWOJE_HASLO@cluster0.xxxxx.mongodb.net/sketchstreak

# Losowy sekret do podpisywania tokenów JWT (nie udostępniaj go nikomu).
# Możesz wygenerować np. poleceniem: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=wpisz_tu_losowy_dlugi_ciag_znakow

# Port backendu (frontend proxuje na niego żądania /api)
PORT=4000
